# Database (PostgreSQL — ta sama instancja co Medusa)
DATABASE_URL=postgresql://medusa:medusa@localhost:5432/medusa_db

# Redis (Upstash / lokalny)
REDIS_URL=redis://localhost:6379

# Worker split (prod): server | worker | shared (dev)
# MEDUSA_WORKER_MODE=shared
# DISABLE_MEDUSA_ADMIN=true

# Feature flags — payment providers
FEATURE_P24=1
FEATURE_STRIPE=1
FEATURE_TPAY=1

# Przelewy24
PRZELEWY24_MERCHANT_ID=
PRZELEWY24_POS_ID=
PRZELEWY24_API_KEY=
PRZELEWY24_CRC=
PRZELEWY24_SANDBOX=true

# Stripe (official @medusajs/medusa/payment-stripe)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CAPTURE=true

# tpay
TPAY_MERCHANT_ID=
TPAY_API_PASSWORD=
TPAY_SECURITY_CODE=
TPAY_SANDBOX=true

# DPD fulfillment
DPD_LOGIN=
DPD_PASSWORD=
DPD_FID=

# Cloudflare R2 (produkcja) — fallback file-local gdy puste
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FILE_URL=
# S3_PREFIX=

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_ADMIN_KEY=masterKey

# Resend — maile transakcyjne + OTP panelu klienta
RESEND_API_KEY=
# RESEND_FROM=Moduly Sklep <kontakt@example.com>
# RESEND_REPLY_TO=kontakt@example.com

# Panel klienta (OTP)
# CUSTOMER_JWT_SECRET=
# CUSTOMER_SESSION_COOKIE=customer_session
# CUSTOMER_SESSION_TTL_SEC=604800

# Revalidacja cache storefrontu
# STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate/medusa
# MEDUSA_REVALIDATE_SECRET=change-me

# Upstash REST — rate limiting /store/custom/*
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Publiczny bootstrap płatności (checkout fallback)
# MODULY_DISABLE_PUBLIC_ENSURE_PAYMENT=true

# Sentry (opcjonalnie)
# SENTRY_DSN=

# App URLs
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:3000
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001,http://localhost:9000
AUTH_CORS=http://localhost:3000
COOKIE_SECRET=supersecret-change-me
JWT_SECRET=supersecret-change-me
