# ── Medusa backend (port jak w lumineconcept / apps/backend) ──
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_PUBLISHABLE_KEY=

# ── Postgres (formularze, zwroty — ta sama instancja co Medusa) ──
DATABASE_URL=postgresql://medusa:medusa@localhost:5432/medusa_db

# ── Publiczny URL sklepu ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Panel magazynu ──
MAGAZYN_ADMIN_ALLOWLIST=
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

# ── Panel klienta (OTP) ──
CUSTOMER_JWT_SECRET=change-me-in-production
CUSTOMER_SESSION_COOKIE=customer_session

# ── Płatności (backend feature flags) ──
FEATURE_P24=1
FEATURE_STRIPE=1
FEATURE_TPAY=1

# ── Przelew manualny (checkout) ──
BANK_TRANSFER_IBAN=PL00000000000000000000000000
BANK_TRANSFER_SWIFT=EXAMPLEPL

# ── Worker Medusa — MUSI być shared (server na 1 instancji wyłącza scheduled
#    jobs reconcile + subscriber order.placed → sieroty + brak maili) ──
MEDUSA_WORKER_MODE=shared

# ── Reconcile / maile (TEN SAM sekret na backendzie i storefroncie, bez spacji) ──
# Cron Vercel /api/cron/reconcile-payments używa CRON_SECRET (Bearer).
CRON_SECRET=
ORDER_EMAIL_INTERNAL_SECRET=
# Publiczny URL storefrontu (backend woła /api/internal/order-email).
STOREFRONT_URL=http://localhost:3000

# ── Anti-abuse: rate-limit checkoutu (Upstash Redis) — ZAWSZE ON na prod ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── CAPTCHA Cloudflare Turnstile — OPCJONALNA, domyślnie OFF (konwersja).
#    Włącz dopiero przy realnym abuse. Zostaw puste = wyłączona. ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cloudflare R2 / S3 (obrazy CMS + produkty) ──
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FILE_URL=
NEXT_PUBLIC_S3_FILE_URL=

# ── Meilisearch (wyszukiwarka) ──
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_ADMIN_KEY=masterKey

# ── Maile (Resend) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=Moduly Sklep <kontakt@example.com>
MODULY_CONTACT_EMAIL=kontakt@example.com

# ── Revalidacja cache (webhook z Medusa) ──
MEDUSA_REVALIDATE_SECRET=change-me
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate/medusa

# ── Google OAuth (opcjonalnie — panel admina) ──
GOOGLE_CLIENT_ID=

# ── Analityka client-side (storefront, produkcja) ──
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# ── Analityka panelu (GA4 + PostHog, server-only) ──
FEATURE_ANALYTICS_PANEL=1
GA4_PROPERTY_ID=
# JSON service account w jednej linii (Vercel / Railway secret)
GA4_SERVICE_ACCOUNT_JSON=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com

# ── Dev: preferuj lokalny backend zamiast Railway ──
# MEDUSA_PREFER_LOCAL=1
