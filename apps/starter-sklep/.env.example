# ── Medusa backend (port jak w lumineconcept / apps/backend) ──
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_PUBLISHABLE_KEY=

# ── Postgres (formularze, zwroty — ta sama instancja co Medusa) ──
DATABASE_URL=postgresql://medusa:medusa@localhost:5432/medusa_db

# ── Publiczny URL sklepu ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Panel magazynu ──
MAGAZYN_ADMIN_ALLOWLIST=
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

# ── Panel klienta (OTP) ──
CUSTOMER_JWT_SECRET=change-me-in-production
CUSTOMER_SESSION_COOKIE=customer_session

# ── Płatności (backend feature flags) ──
FEATURE_P24=1
FEATURE_STRIPE=1
FEATURE_TPAY=1

# ── Przelew manualny (checkout) ──
BANK_TRANSFER_IBAN=PL00000000000000000000000000
BANK_TRANSFER_SWIFT=EXAMPLEPL

# ── Cloudflare R2 / S3 (obrazy CMS + produkty) ──
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FILE_URL=
NEXT_PUBLIC_S3_FILE_URL=

# ── Meilisearch (wyszukiwarka) ──
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_ADMIN_KEY=masterKey

# ── Maile (Resend) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=Moduly Sklep <kontakt@example.com>
MODULY_CONTACT_EMAIL=kontakt@example.com

# ── Revalidacja cache (webhook z Medusa) ──
MEDUSA_REVALIDATE_SECRET=change-me
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate/medusa

# ── Google OAuth (opcjonalnie — panel admina) ──
GOOGLE_CLIENT_ID=

# ── Analityka panelu (GA4 + PostHog, server-only) ──
FEATURE_ANALYTICS_PANEL=1
GA4_PROPERTY_ID=
# JSON service account w jednej linii (Vercel / Railway secret)
GA4_SERVICE_ACCOUNT_JSON=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com

# ── Dev: preferuj lokalny backend zamiast Railway ──
# MEDUSA_PREFER_LOCAL=1
