{
  "name": "@syntance/moduly",
  "version": "0.1.0",
  "description": "CLI do tworzenia projektów Moduly i dokładania modułów",
  "type": "module",
  "bin": {
    "moduly": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
